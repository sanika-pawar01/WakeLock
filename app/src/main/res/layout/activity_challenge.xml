<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Unchanged Full Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Compact Floating HUD Sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hudCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="20dp"
        app:cardBackgroundColor="@color/hud_glass_bg_dark"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/card_stroke_dark"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Squat Challenge"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- Large Counter Focus -->
                <TextView
                    android:id="@+id/counterText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 10"
                    android:textColor="@color/accent_secondary_dark"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-bold" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="14dp"
                android:max="10"
                android:progress="0"
                app:indicatorColor="@color/accent_primary_dark"
                app:trackColor="@color/surface_variant_dark"
                app:trackCornerRadius="4dp" />

            <TextView
                android:id="@+id/txtMotivation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="You've got this."
                android:textColor="@color/text_secondary_dark"
                android:textSize="13sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Challenge Completion Screen Overlay (Initially Hidden) -->
    <FrameLayout
        android:id="@+id/completionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardBackgroundColor="@color/success_bg_dark"
                app:cardCornerRadius="36dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/success_teal"
                    android:textSize="32sp"
                    android:fontFamily="sans-serif-bold" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Nice work!"
                android:textColor="@color/text_primary_dark"
                android:textSize="26sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="10 squats completed. Your alarm has been stopped."
                android:textColor="@color/text_secondary_dark"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Your morning starts now."
                android:textColor="@color/accent_secondary_dark"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartDay"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/accent_primary_dark"
                android:text="START MY DAY"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>